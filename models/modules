class GNN(nn.Module):
    def __init__(self, in_channels, num_classes):
        super(GNN, self).__init__()
        self.in_channels = in_channels
        self.num_classes = num_classes
        # GNN Matrix: E x N
        # Start Matrix Item:  define the source node of one edge
        # End Matrix Item:  define the target node of one edge
        # Algorithm details in Residual Gated Graph Convnets: arXiv preprint arXiv:1711.07553
        # or Benchmarking Graph Neural Networks: arXiv preprint arXiv:2003.00982v3

        start, end = create_e_matrix(self.num_classes)
        self.start = Variable(start, requires_grad=False)
        self.end = Variable(end, requires_grad=False)

        dim_in = self.in_channels
        dim_out = self.in_channels

        self.U1 = nn.Linear(dim_in, dim_out, bias=False)
        self.V1 = nn.Linear(dim_in, dim_out, bias=False)
        self.A1 = nn.Linear(dim_in, dim_out, bias=False)
        self.B1 = nn.Linear(dim_in, dim_out, bias=False)
        self.E1 = nn.Linear(dim_in, dim_out, bias=False)

        # self.U2 = nn.Linear(dim_in, dim_out, bias=False)
        # self.V2 = nn.Linear(dim_in, dim_out, bias=False)
        # self.A2 = nn.Linear(dim_in, dim_out, bias=False)
        # self.B2 = nn.Linear(dim_in, dim_out, bias=False)
        # self.E2 = nn.Linear(dim_in, dim_out, bias=False)

        self.sigmoid = nn.Sigmoid()
        self.softmax = nn.Softmax(2)
        self.bnv1 = nn.BatchNorm1d(num_classes)
        self.bne1 = nn.BatchNorm1d(num_classes*num_classes)

        # self.bnv2 = nn.BatchNorm1d(num_classes)
        # self.bne2 = nn.BatchNorm1d(num_classes * num_classes)

        self.act = nn.ReLU()

        self.init_weights_linear(dim_in, 1)

    def init_weights_linear(self, dim_in, gain):
        # conv1
        scale = gain * np.sqrt(2.0 / dim_in)
        self.U1.weight.data.normal_(0, scale)
        self.V1.weight.data.normal_(0, scale)
        self.A1.weight.data.normal_(0, scale)
        self.B1.weight.data.normal_(0, scale)
        self.E1.weight.data.normal_(0, scale)

        # self.U2.weight.data.normal_(0, scale)
        # self.V2.weight.data.normal_(0, scale)
        # self.A2.weight.data.normal_(0, scale)
        # self.B2.weight.data.normal_(0, scale)
        # self.E2.weight.data.normal_(0, scale)

        bn_init(self.bnv1)
        bn_init(self.bne1)
        # bn_init(self.bnv2)
        # bn_init(self.bne2)

    def forward(self, x, edge):
        # device
        dev = x.get_device()
        if dev >= 0:
            start = self.start.to(dev)
            end = self.end.to(dev)

        # GNN Layer 1:
        res = x
        Vix = self.A1(x)  # V x d_out
        Vjx = self.B1(x)  # V x d_out
        e = self.E1(edge)  # E x d_out
        edge = edge + self.act(self.bne1(torch.einsum('ev, bvc -> bec', (end, Vix)) + torch.einsum('ev, bvc -> bec',(start, Vjx)) + e))  # E x d_out

        e = self.sigmoid(edge)
        b, _, c = e.shape
        e = e.view(b,self.num_classes, self.num_classes, c)
        e = self.softmax(e)
        e = e.view(b, -1, c)

        Ujx = self.V1(x)  # V x H_out
        Ujx = torch.einsum('ev, bvc -> bec', (start, Ujx))  # E x H_out
        Uix = self.U1(x)  # V x H_out
        x = Uix + torch.einsum('ve, bec -> bvc', (end.t(), e * Ujx)) / self.num_classes  # V x H_out
        x = self.act(res + self.bnv1(x))
        res = x

        # # GNN Layer 2:
        # Vix = self.A2(x)  # V x d_out
        # Vjx = self.B2(x)  # V x d_out
        # e = self.E2(edge)  # E x d_out
        # edge = edge + self.act(self.bne2(torch.einsum('ev, bvc -> bec', (end, Vix)) + torch.einsum('ev, bvc -> bec', (start, Vjx)) + e))  # E x d_out

        # e = self.sigmoid(edge)
        # b, _, c = e.shape
        # e = e.view(b, self.num_classes, self.num_classes, c)
        # e = self.softmax(e)
        # e = e.view(b, -1, c)

        # Ujx = self.V2(x)  # V x H_out
        # Ujx = torch.einsum('ev, bvc -> bec', (start, Ujx))  # E x H_out
        # Uix = self.U2(x)  # V x H_out
        # x = Uix + torch.einsum('ve, bec -> bvc', (end.t(), e * Ujx)) / self.num_classes  # V x H_out
        # x = self.act(res + self.bnv2(x))
        return x, edge

class TokenDenseRelationDistill(nn.Module):
    def __init__(self, token_dim, num_tokens=197, keydim=32, valdim=128,
                 num_prototypes=5, dense_sum=False, self_supervised=True):
        super(TokenDenseRelationDistill, self).__init__()

        self.token_dim = token_dim  # D dimension
        self.num_tokens = num_tokens  # 197 tokens
        self.keydim = keydim
        self.valdim = valdim
        self.num_prototypes = num_prototypes
        self.dense_sum = dense_sum
        self.self_supervised = self_supervised
        self.scale = keydim ** -0.5  

        if self.self_supervised:
            self.prototype_generator = nn.Sequential(
                nn.Linear(token_dim, token_dim),
                nn.ReLU(),
                nn.Linear(token_dim, token_dim * num_prototypes)
            )
          
            self.global_attention = nn.MultiheadAttention(
                embed_dim=token_dim, 
                num_heads=8, 
                batch_first=True
            )

        # Teacher key/value projections for attention templates
        self.key_t = nn.Linear(token_dim, keydim)
        self.value_t = nn.Linear(token_dim, valdim)

        if self.dense_sum:
           
            self.key_q_layers = nn.ModuleDict({
                f'key_q{i}': nn.Linear(token_dim, keydim) for i in range(5)
            })
            self.value_q_layers = nn.ModuleDict({
                f'value_q{i}': nn.Linear(token_dim, valdim) for i in range(5)
            })
            self.layer_norms = nn.ModuleDict({
                f'ln{i}': nn.LayerNorm(token_dim) for i in range(5)
            })

            # Combine original and distilled features
            self.combine = nn.Linear(token_dim + valdim, token_dim)
        else:
            # Single query projection
            self.key_q = nn.Linear(token_dim, keydim)
            self.value_q = nn.Linear(token_dim, valdim)
            self.combine = nn.Linear(valdim + token_dim, token_dim)

    def generate_prototypes(self, features):
        """
        从输入特征生成prototype templates
        Args:
            features: [B, num_tokens, D]
        Returns:
            prototypes: [num_prototypes, num_tokens, D]
        """
        bs, num_tokens, token_dim = features.shape

      
        global_feat = features.mean(dim=1)  # [B, D] 

     
        proto_feats = self.prototype_generator(global_feat)  # [B, D*num_prototypes]
        proto_feats = proto_feats.view(bs, self.num_prototypes, token_dim)  # [B, num_prototypes, D]

        
        prototypes = proto_feats.unsqueeze(2).expand(-1, -1, num_tokens, -1)  # [B, num_prototypes, num_tokens, D]
        prototypes = prototypes.mean(dim=0)  # [num_prototypes, num_tokens, D] 在batch维度平均

        return prototypes

    def forward(self, features, attentions=None):
        """
        Args:
            features: List of token sequences or single tensor, each with shape [B, num_tokens, D]
            attentions
        Returns:
            output: Processed token sequences, same shape as input
        """
        if isinstance(features, torch.Tensor):
            features = [features]

        
        if self.self_supervised and attentions is None:
           
            base_feature = features[0]  # [B, num_tokens, D]
            attentions = self.generate_prototypes(base_feature)  # [num_prototypes, num_tokens, D]

        # Process attention templates (support features)
        if isinstance(attentions, dict):
            atten_list = [attentions[i] for i in range(len(attentions))]
            attentions = torch.stack(atten_list, dim=0)  # [num_prototypes, num_tokens, D]

        if attentions.device != features[0].device:
            attentions = attentions.to(features[0].device)

        output = []
        ncls = attentions.shape[0]  # number of prototypes/templates

 
        assert ncls == self.num_prototypes, f"Expected {self.num_prototypes} prototypes, got {ncls}"

        # Generate teacher keys and values from templates
        key_t = self.key_t(attentions)    # [num_prototypes, num_tokens, keydim]
        val_t = self.value_t(attentions)  # [num_prototypes, num_tokens, valdim]

        for idx, feature in enumerate(features):
            bs, num_tokens, token_dim = feature.shape  # [B, num_tokens, D]

           
            assert num_tokens == self.num_tokens, f"Expected {self.num_tokens} tokens, got {num_tokens}"

            # Generate query keys and values
            if self.dense_sum:
                
                layer_idx = idx % 5
                key_q = self.key_q_layers[f'key_q{layer_idx}'](feature)  # [B, num_tokens, keydim]
                val_q = self.value_q_layers[f'value_q{layer_idx}'](feature)  # [B, num_tokens, valdim]
            else:
                key_q = self.key_q(feature)
                val_q = self.value_q(feature)

           
            # key_q: [B, num_tokens, keydim]
            # key_t: [num_prototypes, num_tokens, keydim]
            
            
            key_q_expanded = key_q.unsqueeze(1)  # [B, 1, num_tokens, keydim]
            key_t_expanded = key_t.unsqueeze(0)  # [1, num_prototypes, num_tokens, keydim]
            
           
            # [B, 1, num_tokens, keydim] x [1, num_prototypes, keydim, num_tokens] -> [B, num_prototypes, num_tokens, num_tokens]
            scores = torch.matmul(key_q_expanded, key_t_expanded.transpose(-2, -1)) * self.scale
            attn_weights = F.softmax(scores, dim=-1)  # [B, num_prototypes, num_tokens, num_tokens]

            
            val_t_expanded = val_t.unsqueeze(0)  # [1, num_prototypes, num_tokens, valdim]
            val_t_batch = val_t_expanded.expand(bs, -1, -1, -1)  # [B, num_prototypes, num_tokens, valdim]

            
            attended_values = []
            for j in range(ncls):
                # attn_weights[:, j, :, :]: [B, num_tokens, num_tokens]
                # val_t_batch[:, j, :, :]: [B, num_tokens, valdim]
                # [B, num_tokens, valdim]
                attn_out = torch.matmul(attn_weights[:, j, :, :], val_t_batch[:, j, :, :])
                attended_values.append(attn_out)

            
            attended_values = torch.stack(attended_values, dim=2)  # [B, num_tokens, num_prototypes, valdim]
            aggregated = attended_values.mean(dim=2)  # [B, num_tokens, valdim] 平均聚合

            # Combine with original query features
            if self.dense_sum:
                # Dense connection: concat then combine
                combined = torch.cat([feature, aggregated], dim=-1)  # [B, num_tokens, D+valdim]
                batch_output = self.combine(combined)  # [B, num_tokens, D]

                # Apply layer normalization
                layer_idx = idx % 5
                batch_output = self.layer_norms[f'ln{layer_idx}'](batch_output)

                # Residual connection
                batch_output = batch_output + feature
            else:
                # Simple combination
                if val_q.shape[-1] == aggregated.shape[-1]:
                    combined = val_q + aggregated  # [B, num_tokens, valdim]
                else:
                    combined = torch.cat([val_q, aggregated], dim=-1)

                # Project back to token dimension
                if combined.shape[-1] != token_dim:
                    batch_output = self.combine(combined)
                else:
                    batch_output = combined

            output.append(batch_output)

        return tuple(output) if len(output) > 1 else output[0]

class SFTA(nn.Module):
    def __init__(self, feature_dim, num_heads=1, FFN_method='MLP', mode='SFTA', softmax_score=False):
        super(SFTA, self).__init__()
        self.feature_dim = feature_dim
        self.num_heads = num_heads
        self.FFN_method = FFN_method
        self.mode = mode
        self.softmax_score = softmax_score
        
        # attention
        self.with_W = True
        self.attention = MultiHeadedAttention(self.num_heads, self.feature_dim, with_W=self.with_W)
        
        if self.FFN_method == 'MLP':
            self.FFN = FFN_MLP(self.feature_dim, d_ffn=self.feature_dim*2)
        elif self.FFN_method == 'MLP_one':
            self.FFN = FFN_MLP_one(self.feature_dim, scale=0.01)

    def forward(self, feature, base_class_weight=None, attention_feature=None):
        """
        input Shape: 
        - feature.size = B, c, h, w. B=batch size
        - base_class_weight.size = base_class_num, c.
        - attention_feature.size = B, c, h, w. B=batch size
        output Shape: 
        - output.size = B, c, h, w.
        """
        if (base_class_weight == None) and (attention_feature == None):
            return feature
            
        B, c, h, w = feature.size()
        feature = feature.contiguous().view(B, c, h*w).transpose(1, 2) # (B, h*w, c)
        
        # feature interaction
        q = feature # (B, h*w, c)
        if base_class_weight != None:
            k = v = base_class_weight.repeat(B,1,1) # (B, base_class_num, c)
        elif attention_feature != None:
            k = v = attention_feature.contiguous().view(B, c, h*w).transpose(1, 2) # (B, h*w, c)
            
        aligned_feature, softmax_qk = self.attention(q.transpose(1, 2), k.transpose(1, 2), v.transpose(1, 2)) # (B, c, h*w)

        if self.mode == 'SFTA':
            # Element cosine similarity
            # aligned_feature norm
            aligned_feature = aligned_feature.transpose(1, 2) # (B, h*w, c)
            aligned_feature_norm = torch.norm(aligned_feature, p=2, dim=-1).unsqueeze(2).expand_as(aligned_feature)
            aligned_feature_norm = aligned_feature.div(aligned_feature_norm + 0.00001)
            # feature norm
            feature_norm = torch.norm(feature, p=2, dim=-1).unsqueeze(2).expand_as(feature)
            feature_norm = feature.div(feature_norm + 0.00001)
            # similarity
            cos_scores = torch.sum(aligned_feature_norm * feature_norm, dim=-1)
            if self.softmax_score:
                cos_scores = F.softmax(cos_scores / 0.025, dim=-1) # (B, h*w)
            # spatial attention
            cos_scores = cos_scores.unsqueeze(1) # (B, 1, h*w)
            output = feature.transpose(1, 2) * (cos_scores + 1) # (B, c, h*w)
            output = output.transpose(1, 2) # (B, h*w, c)
        elif self.mode == 'TTA':
            output = aligned_feature.transpose(1, 2) + feature  # (B, h*w, c)

        # FFN_MLP
        if self.FFN_method == 'MLP':
            output = self.FFN(output)  # (B, h*w, c)
        elif self.FFN_method == 'MLP_one':
            output = self.FFN(output)  # (B, h*w, c)
            
        output = output.transpose(1, 2).contiguous().view(B, c, h, w) # (B, c, h, w)
        return output

class SFSA(nn.Module):
    def __init__(self, feature_dim, num_heads=1, FFN_method='MLP', mode='SFSA', patch_size=16, image_size=224):
        super(SFSA, self).__init__()
        self.patch_size = patch_size
        self.image_size = image_size
        
        # 计算patch网格尺寸
        self.num_patches_per_side = image_size // patch_size
        self.total_patches = self.num_patches_per_side ** 2
        
        if mode == 'SFSA':
            self.sfta = SFTA(feature_dim, num_heads=num_heads, FFN_method=FFN_method, mode='SFTA', softmax_score=True)
        elif mode == 'TSA':
            self.sfta = SFTA(feature_dim, num_heads=num_heads, FFN_method=FFN_method, mode='TTA')

    def forward(self, x, attention_feature=None):
        """
        修改后的forward方法，同时支持3D和4D输入
        input Shape: 
        - x.size = B, N, D (ViT format) 或 B, C, H, W (CNN format)
        - attention_feature.size = B, N, D 或 B, C, H, W (可选)
        output Shape: 
        - 保持与输入相同的格式
        """
        # 检查输入维度
        if len(x.shape) == 3:  # ViT format: (B, N, D)
            return self._forward_3d(x, attention_feature)
        elif len(x.shape) == 4:  # CNN format: (B, C, H, W)
            return self._forward_4d(x, attention_feature)
        else:
            raise ValueError(f"Unsupported input shape: {x.shape}")
    
    def _forward_3d(self, x, attention_feature=None):
        """
        处理3D输入 (ViT format)
        """
        B, N, D = x.shape
        
        # 分离CLS token和patch tokens
        if N == self.total_patches + 1:  # 包含CLS token
            cls_token = x[:, 0:1, :]  # (B, 1, D)
            patch_tokens = x[:, 1:, :]  # (B, total_patches, D)
            has_cls_token = True
        elif N == self.total_patches:  # 不包含CLS token
            cls_token = None
            patch_tokens = x  # (B, total_patches, D)
            has_cls_token = False
        else:
            raise ValueError(f"Unexpected sequence length: {N}. Expected {self.total_patches} or {self.total_patches + 1}")
        
        # 将patch tokens转换为4D格式
        H = W = self.num_patches_per_side
        patch_tokens_4d = patch_tokens.transpose(1, 2).reshape(B, D, H, W)  # (B, D, H, W)
        
        # 处理attention_feature
        if attention_feature is not None:
            if len(attention_feature.shape) == 3:
                if attention_feature.shape[1] == self.total_patches + 1:
                    attention_patch_tokens = attention_feature[:, 1:, :]
                else:
                    attention_patch_tokens = attention_feature
                attention_tokens_4d = attention_patch_tokens.transpose(1, 2).reshape(B, D, H, W)
            else:
                attention_tokens_4d = attention_feature
        else:
            attention_tokens_4d = None
        
        # 通过SFTA处理
        if attention_tokens_4d is not None:
            enhanced_patches_4d = self.sfta(patch_tokens_4d, attention_feature=attention_tokens_4d)
        else:
            enhanced_patches_4d = self.sfta(patch_tokens_4d, attention_feature=patch_tokens_4d)
        
        # 转换回3D格式
        enhanced_patches = enhanced_patches_4d.reshape(B, D, -1).transpose(1, 2)  # (B, total_patches, D)
        
        # 重新组合CLS token和patches
        if has_cls_token:
            output = torch.cat([cls_token, enhanced_patches], dim=1)  # (B, N, D)
        else:
            output = enhanced_patches  # (B, total_patches, D)
        
        return output, None
    
    def _forward_4d(self, x, attention_feature=None):
        """
        处理4D输入 (CNN format)
        """
        if attention_feature is not None:
            # 如果提供了attention_feature，使用原来的双向注意力机制
            x = self.sfta(x, attention_feature=attention_feature)
            return x, None
        else:
            # 如果没有提供attention_feature，进行自注意力
            x = self.sfta(x, attention_feature=x)
            return x, None

class CAM(nn.Module):
    """Category-Aware Module"""
    def __init__(self, d_model=768, d_ffn=None, dropout=0.1, activation="relu", num_categories=1):
        super().__init__()
        
        if d_ffn is None:
            d_ffn = d_model * 4
            
        self.d_model = d_model
        self.num_categories = num_categories
        
        
        self.siamese_attn = SingleHeadSiameseAttention(d_model)
        
        # Layer Norm
        self.norm1 = nn.LayerNorm(d_model)
        
        # FFN
        self.linear1 = nn.Linear(d_model, d_ffn)
        self.activation = _get_activation_fn(activation)
        self.dropout1 = nn.Dropout(dropout)
        self.linear2 = nn.Linear(d_ffn, d_model)
        self.dropout2 = nn.Dropout(dropout)
        self.norm2 = nn.LayerNorm(d_model)
        
      
        self.category_codes = nn.Parameter(torch.randn(num_categories, d_model))
        nn.init.xavier_uniform_(self.category_codes)
   
        self.register_buffer('tsp_buffer', torch.zeros(1, 1, d_model))

    def inverse_sigmoid(self, x, eps=1e-5):
        """Inverse sigmoid function"""
        x = x.clamp(min=eps, max=1-eps)
        return torch.log(x / (1 - x))

    def forward_ffn(self, src):
        """FFN forward pass"""
        src2 = self.linear2(self.dropout1(self.activation(self.linear1(src))))
        src = src + self.dropout2(src2)
        src = self.norm2(src)
        return src

    def forward(self, x):
        """
        Args:
            x: [B, 197, D] - input features
        Returns:
            output: [B, 197, D] - processed features (same shape as input)
            attention_weights: attention weights from siamese attention
        """
        batch_size, seq_len, dim = x.shape
        
       
        category_codes = self.category_codes.unsqueeze(0).expand(batch_size, -1, -1)  # [B, num_categories, D]
        
       
        if self.num_categories == 1:
            category_codes = category_codes.expand(-1, seq_len, -1)  # [B, 197, D]
        else:
          
            category_codes = category_codes.repeat(1, seq_len // self.num_categories + 1, 1)[:, :seq_len, :]
        
        
        tsp = self.tsp_buffer.expand(batch_size, seq_len, -1)  # [B, 197, D]
        
        attended_x, tsp_out = self.siamese_attn(
            x, 
            self.inverse_sigmoid(torch.sigmoid(category_codes)), 
            torch.sigmoid(category_codes), 
            tsp
        )
        
        # Layer norm
        attended_x = self.norm1(attended_x)
        
        # FFN
        output = self.forward_ffn(attended_x + tsp_out)
        
        return output, None

class tSF(nn.Module):
    def __init__(self, feature_dim, num_queries=100, num_heads=1, FFN_method='MLP'):
        super(tSF, self).__init__()
        self.feature_dim = feature_dim
        self.num_queries = num_queries
        self.num_heads = num_heads
        self.FFN_method = FFN_method
        # query embedding
        self.query_embed = nn.Embedding(self.num_queries, self.feature_dim)
        # attention
        self.with_W = False
        if self.num_heads > 1:
            self.attention = MultiHeadedAttention(self.num_heads, self.feature_dim, with_W=self.with_W)
            # self.mlp = MLP([self.feature_dim*2, self.feature_dim*2, self.feature_dim])
            # nn.init.constant_(self.mlp[-1].bias, 0.0)
            self.FFN = FFN_MLP(self.feature_dim, d_ffn=self.feature_dim*2)
        else:
            # with W
            if self.with_W:
                self.merge = nn.Conv1d(self.feature_dim, self.feature_dim, kernel_size=1)
                self.proj = nn.ModuleList([deepcopy(self.merge) for _ in range(3)])
            self.attention = ScaledDotProductAttention(temperature=np.power(self.feature_dim, 0.5))
            # FFN
            if self.FFN_method == 'MLP':
                self.FFN = FFN_MLP(self.feature_dim, d_ffn=self.feature_dim*2)

    def forward(self, src):
      
        if src.dim() == 3:
            B, seq_len, dim = src.size()
            cls_token = src[:, 0:1, :]  # 获取分类token [B,1,D]
            patch_tokens = src[:, 1:, :]  # 图像块token [B,196,D]
            
            # 将分类token信息广播到每个图像块
            cls_feature = cls_token.expand_as(patch_tokens)  # [B,196,D]
            patch_tokens = patch_tokens + cls_feature  # 特征融合
            
            # 转换为卷积特征图
            h = w = int(math.sqrt(seq_len - 1))
            src = patch_tokens.permute(0,2,1).view(B,dim,h,w)
        
        B, c, h, w = src.size()
        assert c == self.feature_dim
        src = src.contiguous().view(B, c, h*w).transpose(1, 2) # (B, h*w, c)
        # feature interaction
        q = src # (B, h*w, c)
        query_embed_weight = self.query_embed.weight.unsqueeze(0).repeat(B,1,1) # (B, num_queries, c)
        k = query_embed_weight # (B, num_queries, c)
        v = query_embed_weight # (B, num_queries, c)
        if self.num_heads > 1:
            output, softmax_qk = self.attention(q.transpose(1, 2), k.transpose(1, 2), v.transpose(1, 2))
            # MLP
            # output = self.mlp(torch.cat([src.transpose(1, 2), output], dim=1)) # (B, c, h*w)
            # output = output.contiguous().view(B, c, h, w) # (B, c, h, w)
            # FFN_MLP
            output = output.transpose(1, 2) + src  # (B, h*w, c)
            output = self.FFN(output)  # (B, h*w, c)
            output = output.transpose(1, 2).contiguous().view(B, c, h, w) # (B, c, h, w)
        else:
            # with W
            if self.with_W:
                q, k, v = [l(x) for l, x in zip(self.proj, (q.transpose(1, 2),
                            k.transpose(1, 2), v.transpose(1, 2)))]
                q = q.transpose(1, 2)
                k = k.transpose(1, 2)
                v = v.transpose(1, 2)

            output, _, softmax_qk = self.attention(q, k, v) # (B, h*w, c)
            # residual {add / product / cat+conv}
            output = output + src  # (B, h*w, c)
            # FFN
            if self.FFN_method == 'MLP':
                output = self.FFN(output)  # (B, h*w, c)
                output = output.transpose(1, 2).contiguous().view(B, c, h, w) # (B, c, h, w)
            else:
                output = output.transpose(1, 2).contiguous().view(B, c, h, w) # (B, c, h, w)
                
             # 最终转换回序列格式
            output = output.view(B, self.feature_dim, h*w).permute(0,2,1)  # [B,196,512]
            
            # 重新拼接分类token
            if cls_token is not None:
                output = torch.cat([cls_token, output], dim=1)  # [B,197,512]
            
        return output, softmax_qk

class ConvGRUCell(nn.Module):
    
    def __init__(self, input_size, hidden_size, all_dim, kernel_size):
        super(ConvGRUCell,self).__init__()
        self.cuda_flag   = True
        self.input_size = input_size
        self.hidden_size = hidden_size
        self.padding = int((kernel_size - 1) / 2)
        self.reset_gate = nn.Conv2d(input_size + hidden_size, hidden_size, kernel_size, padding=self.padding)
        self.update_gate = nn.Conv2d(input_size + hidden_size, hidden_size, kernel_size, padding=self.padding)
        self.out_gate = nn.Conv2d(input_size + hidden_size, hidden_size, kernel_size, padding=self.padding)

        nn.init.orthogonal_(self.reset_gate.weight)
        nn.init.orthogonal_(self.update_gate.weight)
        nn.init.orthogonal_(self.out_gate.weight)
        nn.init.constant_(self.reset_gate.bias, 0.)
        nn.init.constant_(self.update_gate.bias, 0.)
        nn.init.constant_(self.out_gate.bias, 0.)

    def forward(self, input_, prev_state):

        # get batch and spatial sizes
        batch_size = input_.size()[0]
        spatial_size = input_.size()[2:]

        # generate empty prev_state, if None is provided
        if prev_state is None:
            state_size = [batch_size, self.hidden_size] + list(spatial_size)
            if torch.cuda.is_available():
                prev_state = Variable(torch.zeros(state_size)).cuda()
            else:
                prev_state = Variable(torch.zeros(state_size))

        # data size is [batch, channel, height, width]
        stacked_inputs = torch.cat([input_, prev_state], dim=1)
        update = F.sigmoid(self.update_gate(stacked_inputs))
        reset = F.sigmoid(self.reset_gate(stacked_inputs))
        out_inputs = F.tanh(self.out_gate(torch.cat([input_, prev_state * reset], dim=1)))
        new_state = prev_state * (1 - update) + out_inputs * update

        return new_state

class CoattentionModel(nn.Module):
    def __init__(self, all_channel=512, all_dim=12): 
        super(CoattentionModel, self).__init__()
        self.linear_e = nn.Linear(all_channel, all_channel, bias=False)
        self.channel = all_channel
        self.dim = all_dim * all_dim
        self.gate = nn.Conv2d(all_channel, 1, kernel_size=1, bias=False)
        self.gate_s = nn.Sigmoid()
        self.conv1 = nn.Conv2d(all_channel * 2, all_channel, kernel_size=3, padding=1, bias=True)
        self.ConvGRU = ConvGRUCell(all_channel, all_channel, all_dim, kernel_size=1)
        self.bn1 = nn.BatchNorm2d(all_channel)
        self.prelu = nn.ReLU(inplace=True)
        self.propagate_layers = 5
        
    def forward(self, x):
        # x shape: [batch, num_patches+1, dim]
        batch_size = x.shape[0]
        x_tokens = x[:, 1:, :]  # [batch, num_patches, dim]
        
   
        num_patches = x_tokens.shape[1]
        H = W = int(np.sqrt(num_patches))
        x_conv = x_tokens.transpose(1, 2).reshape(batch_size, -1, H, W)
        
        # self-attention propagation
        h = x_conv
        for _ in range(self.propagate_layers):
            attention = self.generate_attention(h, h)
            h = self.ConvGRU(attention, h)
    
        h = h.reshape(batch_size, -1, num_patches).transpose(1, 2)
        
        
        output = torch.cat([x[:, 0:1, :], h], dim=1)
        
        return output, None  
    
    def generate_attention(self, exemplar, query):
        # self-attention 
        fea_size = query.size()[2:]
        exemplar_flat = exemplar.view(-1, self.channel, fea_size[0] * fea_size[1])
        query_flat = query.view(-1, self.channel, fea_size[0] * fea_size[1])
        exemplar_t = torch.transpose(exemplar_flat, 1, 2).contiguous()
        exemplar_corr = self.linear_e(exemplar_t)
        A = torch.bmm(exemplar_corr, query_flat)
        B = F.softmax(torch.transpose(A, 1, 2), dim=1)
        exemplar_att = torch.bmm(query_flat, B).contiguous()
        input1_att = exemplar_att.view(-1, self.channel, fea_size[0], fea_size[1])
        input1_mask = self.gate(input1_att)
        input1_mask = self.gate_s(input1_mask)
        input1_att = input1_att * input1_mask
        return input1_att
